<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_item"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_new_item_short"
        android:shortcutLongLabel="@string/shortcut_new_item_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="todo://item/new"
            android:targetPackage="com.alexhokl.todo"
            android:targetClass="com.alexhokl.todo.MainActivity"/>
    </shortcut>
    <shortcut
        android:shortcutId="untriaged"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_untriaged_short"
        android:shortcutLongLabel="@string/shortcut_untriaged_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="todo://items?view=untriaged"
            android:targetPackage="com.alexhokl.todo"
            android:targetClass="com.alexhokl.todo.MainActivity"/>
    </shortcut>
    <shortcut
        android:shortcutId="time_sensitive"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_time_sensitive_short"
        android:shortcutLongLabel="@string/shortcut_time_sensitive_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="todo://items?view=time-sensitive"
            android:targetPackage="com.alexhokl.todo"
            android:targetClass="com.alexhokl.todo.MainActivity"/>
    </shortcut>
</shortcuts>
